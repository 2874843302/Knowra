KNOWRA_DATA_DIR=.local
KNOWRA_DATABASE_URL=postgresql://knowra:change-me@127.0.0.1:5432/knowra
KNOWRA_DATABASE_POOL_SIZE=10
# Docker Compose uses the same password as the URL above
KNOWRA_POSTGRES_PASSWORD=change-me
# Dedicated test database; never use the application database for tests
KNOWRA_TEST_DATABASE_URL=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# Official DeepSeek V4 course generation: none (fast), low, high.
# Chat and other providers keep their own defaults; content validation stays on.
KNOWRA_AI_GENERATION_EFFORT=none
# Optional local speech recognition overrides (default: .local/asr/models/...)
# KNOWRA_ASR_MODEL_DIR=
KNOWRA_ASR_THREADS=2
