KNOWRA_DATA_DIR=.local
KNOWRA_DATABASE_URL=postgresql://knowra:change-me@127.0.0.1:5432/knowra
KNOWRA_DATABASE_POOL_SIZE=10
# Master key that encrypts stored model API keys. Generate with:
#   python scripts/secret-key.py
# Losing this key makes saved API keys unrecoverable; back it up separately.
KNOWRA_SECRET_KEY=
# Docker Compose uses the same password as the URL above
KNOWRA_POSTGRES_PASSWORD=change-me
# Dedicated test database; never use the application database for tests
KNOWRA_TEST_DATABASE_URL=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# Official DeepSeek V4 course generation: none (fast), low, high.
# Chat and other providers keep their own defaults; content validation stays on.
KNOWRA_AI_GENERATION_EFFORT=none
# Optional local speech recognition overrides (default: .local/asr/models/...)
# KNOWRA_ASR_MODEL_DIR=
KNOWRA_ASR_THREADS=2
# Optional Tencent Cloud TTS. When configured, two cloud voices appear in the
# board settings; text selected for those voices is sent to Tencent Cloud.
# TENCENT_TTS_SECRET_ID=
# TENCENT_TTS_SECRET_KEY=
# TENCENT_TTS_REGION=ap-guangzhou
# TENCENT_TTS_VOICE_FEMALE=101001
# TENCENT_TTS_VOICE_MALE=101004
# 101001/101004 是精品音色，ModelType 默认为 2；基础音色改为 1。
# TENCENT_TTS_MODEL_TYPE=2
# TENCENT_TTS_SAMPLE_RATE=16000
# TENCENT_TTS_SPEED=0
